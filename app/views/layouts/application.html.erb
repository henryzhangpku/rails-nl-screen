<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "NL Screen" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Turbo 8 animates page changes with the browser's View Transitions API when this is present. %>
    <meta name="view-transition" content="same-origin">
    <%= yield :head %>

    <%= render "shared/head_icons" %>
    <meta name="author" content="Henry Zhang">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@500;600&family=Public+Sans:wght@400;600&display=swap">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="ns-topbar">
      <%= link_to root_path, class: "ns-topbar__brand" do %><img src="/icon.svg" alt="" width="22" height="22"><span>NL<i class="ns-topbar__slash">/</i>Screen</span><% end %>
      <nav class="ns-topbar__nav" aria-label="Main">
        <%= link_to "New screen", new_screen_path, class: "ns-topbar__link", aria: { current: ("page" if current_page?(new_screen_path) || current_page?(root_path)) } %>
        <%= link_to "History", screens_path, class: "ns-topbar__link", aria: { current: ("page" if current_page?(screens_path)) } %>
        <%= link_to "Prompts", "/prompts", class: "ns-topbar__link", data: { turbo: false } %>
        <% if authenticated? %>
          <%= button_to "Sign out", session_path, method: :delete, class: "ns-topbar__link ns-topbar__button" %>
        <% end %>
      </nav>
      <%= render "shared/repo_link" %>
    </header>
    <div id="toast" class="ns-toast-slot"><%= render "shared/toast" %></div>
    <main class="ns-page">
      <%= yield %>
    </main>
    <%= render "shared/footer" %>
  </body>
</html>
