<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "NL Screen" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@500;600&family=Public+Sans:wght@400;600&display=swap">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <%= link_to root_path, class: "brand" do %>NL<span>/</span>Screen<% end %>
      <span class="meta">plain-English stock screens · Rails 8 + Hotwire</span>
      <a class="repo" href="https://github.com/henryzhangpku/rails-nl-screen">Code on GitHub ↗</a>
    </header>
    <main>
      <%= yield %>
    </main>
  </body>
</html>
