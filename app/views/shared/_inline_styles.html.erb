<%# All component stylesheets concatenated, foundation first, for pages without an asset server (static demo, preview card). %>
<% files = Rails.root.glob("app/assets/stylesheets/*.css").sort_by { |f| [ f.basename.to_s == "foundation.css" ? 0 : 1, f.basename.to_s ] } %>
<%= safe_join(files.map { |f| f.read.html_safe }, "\n") %>
