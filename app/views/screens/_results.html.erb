<section class="stack">
  <div>
    <h2>Ranked results</h2>
    <p class="muted">Score = how far past each threshold, averaged (0 to 1). A fresher MACD cross scores higher.</p>
  </div>
  <div class="table-wrap">
    <table class="results">
      <thead>
        <tr>
          <th>#</th>
          <th>Ticker</th>
          <th>Score</th>
          <% screen.conditions.each do |condition| %>
            <th class="cond"><%= condition.label %></th>
          <% end %>
          <th>Why it matched</th>
        </tr>
      </thead>
      <tbody id="matches"><%= render partial: "matches/match", collection: screen.matches, as: :match %></tbody>
    </table>
  </div>
</section>
