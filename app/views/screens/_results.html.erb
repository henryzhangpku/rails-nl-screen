<section class="ns-stack">
  <div>
    <h2>Ranked results</h2>
    <p class="ns-text--muted">
      Ranked by <%= screen.spec.fetch("rank", []).map { |r| "#{ScreenSpec.label(r["field"])} (#{r["direction"] == "desc" ? "highest" : "lowest"} first)" }.to_sentence %>.
      Score = weighted mean of percentile ranks among the matches (0 to 1); ties go to the more liquid name. Top <%= screen.top_n %> highlighted.
    </p>
  </div>
  <div class="ns-table-wrap">
    <table class="ns-table">
      <thead>
        <tr>
          <th class="ns-table__head">#</th>
          <th class="ns-table__head">Ticker</th>
          <th class="ns-table__head">Score</th>
          <% screen.table_fields.each do |field| %>
            <th class="ns-table__head ns-table__head--condition"><%= ScreenSpec.label(field) %></th>
          <% end %>
          <th class="ns-table__head">Why it matched</th>
        </tr>
      </thead>
      <tbody id="matches" class="ns-table__body"><%= render partial: "matches/match", collection: screen.matches, as: :match %></tbody>
    </table>
  </div>
</section>
