<section class="stack">
  <h1>Here's what I understood</h1>
  <div class="prompt"><%= screen.query %></div>
  <ul class="chips">
    <% screen.conditions.each do |condition| %>
      <li class="chip"><%= condition.label.delete_suffix(" (weekly)") %><% if condition.timeframe == "weekly" %><span class="tf">weekly</span><% end %></li>
    <% end %>
  </ul>
  <% notes = screen.notes.grep_v(/\ANo data/) %>
  <% if notes.any? %>
    <ul class="notes">
      <% notes.each do |note| %><li><%= note %></li><% end %>
    </ul>
  <% end %>
  <% if screen.proposal.present? %>
    <details class="audit">
      <summary>Parsed by <%= screen.parser %>; raw proposal before validation</summary>
      <pre><%= JSON.pretty_generate(screen.proposal) %></pre>
    </details>
  <% end %>
</section>
