<tr id="<%= dom_id(screen) %>">
  <td class="ns-table__cell ns-table__cell--number"><%= l screen.created_at, format: :short %></td>
  <td class="ns-table__cell ns-table__cell--why">
    <%# _top: open the screen as a full page, not inside the frame. The view-transition name pairs with the show page. %>
    <%= link_to screen.query, screen, class: "ns-history__link", data: { turbo_frame: "_top" }, style: "view-transition-name: #{dom_id(screen)}" %>
  </td>
  <td class="ns-table__cell"><span class="ns-status ns-status--<%= screen.status %>"><%= screen.status.humanize %></span></td>
  <td class="ns-table__cell ns-text--muted"><%= screen.source == "llm" ? "LLM" : "Rules" %></td>
  <td class="ns-table__cell ns-table__cell--number"><%= screen.matches_count %></td>
  <td class="ns-table__cell">
    <%= button_to "Delete", screen, method: :delete, class: "ns-history__delete",
          form: { data: { turbo_confirm: "Delete this screen and its matches?" } } %>
  </td>
</tr>
