<div id="progress" class="ns-stats">
  <div class="ns-stats__item">
    <span class="ns-text--eyebrow">Matches</span>
    <span class="ns-stats__value <%= "ns-stats__value--up" if screen.matches.any? %>"><%= screen.matches.size %></span>
  </div>
  <div class="ns-stats__item">
    <span class="ns-text--eyebrow">Scanned</span>
    <span class="ns-stats__value"><%= screen.done? ? screen.universe_size : screen.scanned_count %><span class="ns-text--muted"> / <%= screen.universe_size %></span></span>
  </div>
  <div class="ns-stats__item">
    <span class="ns-text--eyebrow">Status</span>
    <% case screen.status %>
    <% when "pending" %>
      <span class="ns-stats__value ns-stats__value--muted">Queued</span>
    <% when "running" %>
      <span class="ns-stats__value">Scanning</span>
      <progress value="<%= screen.scanned_count %>" max="<%= screen.universe_size %>"></progress>
    <% when "done" %>
      <span class="ns-stats__value ns-stats__value--up">Done</span>
    <% when "failed" %>
      <span class="ns-stats__value ns-stats__value--error">Failed</span>
      <span class="ns-text--muted"><%= screen.error_message %></span>
    <% end %>
  </div>
  <% screen.notes.grep(/\ANo data/).each do |note| %>
    <div class="ns-stats__item"><span class="ns-text--eyebrow">Data gaps</span><span class="ns-text--muted"><%= note.sub("No data for ", "") %></span></div>
  <% end %>
</div>
