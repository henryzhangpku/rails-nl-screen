<div id="progress" class="progress <%= screen.status %>">
  <% case screen.status %>
  <% when "pending" %>
    Queued…
  <% when "running" %>
    Scanning <%= screen.scanned_count %> / <%= screen.universe_size %> symbols — <%= pluralize(screen.matches.size, "match") %> so far
    <progress value="<%= screen.scanned_count %>" max="<%= screen.universe_size %>"></progress>
  <% when "done" %>
    Done: <%= pluralize(screen.matches.size, "match") %> out of <%= screen.universe_size %> symbols.
    <% screen.notes.grep(/\ANo data/).each do |note| %><span class="muted"><%= note %></span><% end %>
  <% when "failed" %>
    Failed: <%= screen.error_message %>
  <% end %>
</div>
