<% content_for :title, "NL Screen" %>

<section class="ns-stack">
  <span class="ns-text--eyebrow">Plain English in, ranked stocks out</span>
  <h1>Type a stock screen the way you'd say it.</h1>
  <p class="ns-text--lede">Each query below was parsed into typed, whitelisted conditions, run over 100 large US stocks, and the survivors ranked by how decisively they pass.</p>
</section>

<section class="ns-cards">
  <% @screens.each_with_index do |screen, i| %>
    <a class="ns-card" href="screen-<%= i + 1 %>.html">
      <span class="ns-card__query"><%= screen.query %></span>
      <ul class="ns-chips">
        <% screen.conditions.each do |condition| %>
          <li class="ns-chip"><%= condition.label.delete_suffix(" (weekly)") %><% if condition.timeframe == "weekly" %><span class="ns-chip__timeframe">wk</span><% end %></li>
        <% end %>
      </ul>
      <span class="ns-card__count <%= "ns-card__count--zero" if screen.matches.empty? %>"><b class="ns-card__count-value"><%= screen.matches.size %></b><span class="ns-text--muted">of <%= screen.universe_size %> matched</span></span>
      <% if screen.matches.any? %>
        <span class="ns-card__tickers">
          <% screen.matches.first(6).each do |match| %><span class="ns-card__ticker"><%= match.symbol %></span><% end %>
          <% if screen.matches.size > 6 %><span class="ns-text--muted">+<%= screen.matches.size - 6 %></span><% end %>
        </span>
      <% end %>
    </a>
  <% end %>
</section>
