<%# 1200x627 link-preview card (LinkedIn/Slack/X). Screenshotted by demo:export; not part of the site. %>
<% featured = @screens.max_by { |s| s.matches.size } %>
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@500;600&family=Public+Sans:wght@400;600&display=swap">
    <style>
      <%= render "shared/inline_styles" %>
      html, body { width: 1200px; height: 627px; margin: 0; overflow: hidden; }
      .ns-og { box-sizing: border-box; height: 100%; display: grid; grid-template-columns: 1.05fr 1fr; gap: 44px; padding: 56px 60px; background: var(--ns-paper); }
      .ns-og__left { display: grid; align-content: space-between; }
      .ns-og__mark { display: flex; align-items: center; gap: 12px; font: 800 26px/1 var(--ns-font-display); }
      .ns-og__slash { font-style: normal; color: var(--ns-accent); }
      .ns-og__title { font: 800 54px/1.04 var(--ns-font-display); letter-spacing: -0.02em; margin: 0; }
      .ns-og__prompt { font: 500 19px/1.45 var(--ns-font-mono); padding: 16px 18px; border: 1px solid var(--ns-rule); border-left: 4px solid var(--ns-accent); border-radius: 8px; background: var(--ns-surface); }
      .ns-og__prompt::before { content: "› "; color: var(--ns-accent); }
      .ns-og__tags { font: 600 15px/1 var(--ns-font-mono); color: var(--ns-ink-2); letter-spacing: 0.04em; }
      .ns-og__panel { align-self: center; border: 1px solid var(--ns-rule); border-radius: 14px; background: var(--ns-surface); overflow: hidden; box-shadow: 0 18px 40px -24px rgba(16, 24, 40, .35); }
      .ns-og__panel-head { display: flex; justify-content: space-between; align-items: baseline; padding: 18px 22px; border-bottom: 1px solid var(--ns-rule); }
      .ns-og__count { font: 600 34px/1 var(--ns-font-mono); color: var(--ns-up); }
      .ns-og__row { display: grid; grid-template-columns: 34px 92px 1fr 52px; align-items: center; gap: 12px; padding: 13px 22px; border-bottom: 1px solid var(--ns-rule); font: 500 17px/1 var(--ns-font-mono); }
      .ns-og__row:last-child { border-bottom: 0; }
      .ns-og__ticker { font: 700 19px/1 var(--ns-font-display); }
      .ns-og__bar { height: 6px; border-radius: 3px; background: var(--ns-rule); overflow: hidden; }
      .ns-og__fill { display: block; height: 100%; background: var(--ns-up); }
    </style>
  </head>
  <body>
    <div class="ns-og">
      <div class="ns-og__left">
        <div class="ns-og__mark"><img src="data:image/svg+xml,<%= ERB::Util.url_encode(Rails.root.join("public/icon.svg").read.strip) %>" width="40" height="40" alt=""><span>NL<i class="ns-og__slash">/</i>Screen</span></div>
        <h1 class="ns-og__title">Type a stock screen the way you'd say it.</h1>
        <div class="ns-og__prompt"><%= featured.query %></div>
        <div class="ns-og__tags">BY HENRY ZHANG · RAILS 8 · HOTWIRE · REAL DAILY PRICES</div>
      </div>
      <div class="ns-og__panel">
        <div class="ns-og__panel-head"><span class="ns-text--eyebrow">Ranked survivors · <%= @built_on.to_fs(:long) %></span><span><b class="ns-og__count"><%= featured.matches.size %></b> <span class="ns-text--muted">/ <%= featured.universe_size %></span></span></div>
        <% featured.matches.first(6).each_with_index do |match, i| %>
          <div class="ns-og__row"><span class="ns-text--muted"><%= i + 1 %></span><span class="ns-og__ticker"><%= match.symbol %></span><span class="ns-og__bar"><i class="ns-og__fill" style="width: <%= (match.score * 100).round %>%"></i></span><span><%= number_with_precision(match.score, precision: 2) %></span></div>
        <% end %>
      </div>
    </div>
  </body>
</html>
